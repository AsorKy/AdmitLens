# Level-1 local settings: names and safe defaults only (contract KE, PLAN-CA-0005).
# Create your .env with `make env`. Never copy this file by hand and never commit .env.
#   __GENERATE__  `make env` puts a fresh random value there (openssl rand -hex 24).
#   ${NAME}       `make env` substitutes the value of NAME, defined above it.

# PostgreSQL 16 server (docker-compose.yml)
POSTGRES_USER=admitlens
POSTGRES_DB=admitlens
POSTGRES_PASSWORD=__GENERATE__
ADMITLENS_DB_PORT=5432

# Application and tests (read by app/config.py; the test database comes from `make db-up`)
ADMITLENS_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${ADMITLENS_DB_PORT}/${POSTGRES_DB}
ADMITLENS_TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${ADMITLENS_DB_PORT}/admitlens_test
