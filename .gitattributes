* text=auto eol=lf

*.sh text eol=lf
.githooks/* text eol=lf
Makefile text eol=lf
*.mk text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Binary markers (-diff/binary/diff=) only on the closed list of binary
# extensions enforced by `guards lint` (gitattributes-diff). Git detects other
# binaries by itself; data files are ignored and never committed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
