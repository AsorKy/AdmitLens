# AdmitLens root .gitignore: the safety net (public repository).
# The ONLY negation allowed is !.env.example. Do not add others.

# --- Secrets ---
.env
.env.*
*.env
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
*.age
.netrc
.pgpass
.npmrc
.pypirc
.git-credentials
secrets/

# --- Local files and assistant artifacts (never versioned) ---
.claude/
**/.claude/
CLAUDE.md
**/CLAUDE.md
CLAUDE.local.md
*.local.md
*.local.toml
.mcp.json
.omc/
.tools/
docker-compose.override.yml

# --- Data ---
# Fixture CSVs, if a test ever needs one, require an exact-path negation
# reviewed by security. No general negation is allowed.
data/
*.csv
*.parquet
*.xlsx
*.sav
*.dta
*.rdata
*.rds
*.sas7bdat
*.jsonl
*.pkl
*.ipynb
*.zip
*.gz
*.tar

# --- Databases and dumps ---
*.db
*.sqlite*
*.db-*
*.dump
# Dumps only: migrations and init scripts (*.sql) must stay trackable.
dump*.sql
*_dump.sql
*.sql.gz
*.sql.bz2
*.sql.xz
*.bak
backups/
pgdata/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
coverage.xml
htmlcov/
coverage/
junit*.xml
*.egg-info/
.hypothesis/

# --- Node ---
node_modules/
dist/
.vite/
.vercel/
playwright-report/
test-results/
blob-report/
*.tsbuildinfo

# --- Reports ---
*.sarif
gitleaks-report*
.secrets.baseline
*.log

# --- Editor and OS ---
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
*.swp
*~
