#!/bin/sh
# Thin hook: `make hook-pre-push` reads the refs on stdin; remote name and push URL ($2) travel in the env.
command -v make >/dev/null 2>&1 || { echo "pre-push: make not found; push blocked" >&2; exit 2; }
top=$(git rev-parse --show-toplevel) || exit 2
REMOTE="$1" PUSH_URL="$2" MAKEFILES= MAKEFLAGS= MFLAGS= GNUMAKEFLAGS= exec make -s -C "$top" -f Makefile hook-pre-push
